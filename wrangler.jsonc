{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech",
  "compatibility_date": "2026-05-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "drop",
    "not_found_handling": {
      "custom_404_page": "404.html"
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
